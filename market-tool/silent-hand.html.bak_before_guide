<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Silent Hand v1.1 — Trợ Lý Thực Thi Lệnh Tự Động Từ Mọi AI</title>
  <style>
    :root {
      --bg: #07101f;
      --card: rgba(13, 25, 45, 0.88);
      --border: rgba(0, 229, 255, 0.22);
      --accent: #00e5ff;
      --accent2: #38bdf8;
      --green: #22c55e;
      --warn: #f59e0b;
      --danger: #ef4444;
      --momo: #d82d8b;
      --text: #e2e8f0;
      --muted: #94a3b8;
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
      background: radial-gradient(circle at top center, #10203a 0%, var(--bg) 58%);
      color: var(--text);
      min-height: 100vh;
      padding: 24px 16px 64px;
      line-height: 1.55;
    }
    .wrap { max-width: 1040px; margin: 0 auto; }
    .topbar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 24px;
      gap: 12px;
      flex-wrap: wrap;
    }
    .back-link {
      color: var(--accent);
      text-decoration: none;
      font-weight: 600;
      font-size: 14px;
      padding: 8px 14px;
      border-radius: 10px;
      background: rgba(0, 229, 255, 0.08);
      border: 1px solid var(--border);
    }
    .back-link:hover { background: rgba(0, 229, 255, 0.16); }
    .badge {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 6px 14px;
      border-radius: 999px;
      background: rgba(0, 229, 255, 0.1);
      border: 1px solid var(--border);
      color: var(--accent);
      font-size: 13px;
      font-weight: 700;
      letter-spacing: 0.4px;
    }
    .dot { width: 8px; height: 8px; border-radius: 50%; background: var(--green); box-shadow: 0 0 10px var(--green); }
    .hero {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 20px;
      padding: 32px 26px;
      text-align: center;
      margin-bottom: 24px;
      box-shadow: 0 20px 50px rgba(0, 0, 0, 0.35);
    }
    h1 {
      font-size: clamp(26px, 4.6vw, 42px);
      font-weight: 800;
      margin: 14px 0 10px;
      background: linear-gradient(90deg, #ffffff, var(--accent));
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }
    .subtitle {
      color: var(--muted);
      max-width: 720px;
      margin: 0 auto 22px;
      font-size: 15.5px;
    }
    .cta-row {
      display: flex;
      justify-content: center;
      gap: 12px;
      flex-wrap: wrap;
    }
    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      padding: 13px 22px;
      border-radius: 12px;
      font-weight: 700;
      font-size: 15px;
      text-decoration: none;
      cursor: pointer;
      border: none;
      transition: transform 0.15s ease, opacity 0.15s ease;
    }
    .btn:hover { transform: translateY(-1px); opacity: 0.95; }
    .btn-primary {
      background: linear-gradient(135deg, var(--accent), #0284c7);
      color: #04101f;
    }
    .btn-momo {
      background: linear-gradient(135deg, #d82d8b, #a50064);
      color: #fff;
    }
    .btn-ghost {
      background: rgba(255, 255, 255, 0.06);
      color: var(--text);
      border: 1px solid rgba(255, 255, 255, 0.14);
    }
    .pill-row {
      display: flex;
      justify-content: center;
      gap: 10px;
      flex-wrap: wrap;
      margin-top: 18px;
      font-size: 13px;
      color: #cbd5e1;
    }
    .pill {
      padding: 5px 12px;
      border-radius: 999px;
      background: rgba(255, 255, 255, 0.05);
      border: 1px solid rgba(255, 255, 255, 0.1);
    }
    .section-title {
      font-size: 20px;
      font-weight: 800;
      margin: 28px 0 14px;
      color: #fff;
    }
    .grid-3 {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
      gap: 14px;
    }
    .card {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 16px;
      padding: 18px;
    }
    .card h3 { font-size: 16px; color: var(--accent); margin-bottom: 8px; }
    .card p { font-size: 14px; color: var(--muted); }
    .shield-box {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 14px;
      margin-top: 10px;
    }
    .shield-card {
      background: rgba(15, 23, 42, 0.9);
      border-radius: 16px;
      padding: 18px;
      border: 1px solid rgba(245, 158, 11, 0.35);
    }
    .shield-card.kill { border-color: rgba(239, 68, 68, 0.45); }
    .shield-card h3 { font-size: 16px; margin-bottom: 6px; }
    .shield-card p { font-size: 14px; color: var(--muted); }
    .pricing-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 14px;
      margin-bottom: 20px;
    }
    .plan {
      background: var(--card);
      border: 1.5px solid var(--border);
      border-radius: 16px;
      padding: 18px;
      cursor: pointer;
      transition: border-color 0.15s ease, transform 0.15s ease, background 0.15s ease;
      position: relative;
    }
    .plan:hover { transform: translateY(-2px); border-color: var(--accent); }
    .plan.active {
      border-color: var(--momo);
      background: rgba(216, 45, 139, 0.14);
      box-shadow: 0 0 0 2px rgba(216, 45, 139, 0.28);
    }
    .plan-badge {
      position: absolute;
      top: 10px;
      right: 10px;
      font-size: 11px;
      font-weight: 700;
      padding: 3px 8px;
      border-radius: 999px;
      background: rgba(0, 229, 255, 0.15);
      color: var(--accent);
    }
    .plan-dur { font-size: 15px; font-weight: 700; color: #fff; }
    .plan-price { font-size: 26px; font-weight: 800; color: var(--accent); margin: 6px 0 4px; }
    .plan-sub { font-size: 13px; color: var(--muted); }
    .momo-panel {
      background: #1a1025;
      border: 1.5px solid rgba(216, 45, 139, 0.55);
      border-radius: 20px;
      padding: 24px;
      display: grid;
      grid-template-columns: 240px 1fr;
      gap: 24px;
      align-items: center;
    }
    @media (max-width: 720px) {
      .momo-panel { grid-template-columns: 1fr; text-align: center; }
    }
    .qr-box {
      background: #fff;
      border-radius: 14px;
      padding: 12px;
      text-align: center;
      color: #111827;
    }
    .qr-box img { width: 100%; max-width: 210px; border-radius: 8px; display: block; margin: 0 auto 8px; }
    .qr-caption { font-size: 12.5px; font-weight: 700; color: #a50064; }
    .field-label { font-size: 13px; color: #f5d0fe; font-weight: 600; margin-bottom: 6px; display: block; }
    .input-row {
      display: flex;
      gap: 8px;
      flex-wrap: wrap;
      margin-bottom: 12px;
    }
    .input-mid {
      flex: 1;
      min-width: 190px;
      padding: 11px 14px;
      border-radius: 10px;
      border: 1px solid rgba(216, 45, 139, 0.45);
      background: rgba(9, 13, 28, 0.85);
      color: #fff;
      font-family: Consolas, monospace;
      font-size: 15px;
      font-weight: 700;
      letter-spacing: 0.6px;
    }
    .memo-box {
      background: rgba(0, 0, 0, 0.35);
      border: 1px dashed rgba(216, 45, 139, 0.6);
      border-radius: 12px;
      padding: 12px 14px;
      margin: 12px 0;
      font-size: 14px;
    }
    .memo-code {
      font-family: Consolas, monospace;
      font-size: 18px;
      font-weight: 800;
      color: #f472b6;
    }
    .status-out {
      margin-top: 12px;
      padding: 11px 14px;
      border-radius: 10px;
      font-size: 13.5px;
      background: rgba(0, 229, 255, 0.08);
      border: 1px solid var(--border);
      display: none;
    }
    .steps {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
      gap: 12px;
    }
    .step {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 14px;
      padding: 16px;
      font-size: 14px;
      color: var(--muted);
    }
    .step b { color: #fff; display: block; margin-bottom: 6px; }
    footer {
      text-align: center;
      margin-top: 36px;
      font-size: 13px;
      color: var(--muted);
    }
  </style>
</head>
<body>
  <div class="wrap">
    <div class="topbar">
      <a class="back-link" href="./index.html">← Quay lại Market Tool</a>
      <span class="badge"><span class="dot"></span> SILENT HAND v1.1 • SERVER TIME SYNC</span>
    </div>

    <section class="hero">
